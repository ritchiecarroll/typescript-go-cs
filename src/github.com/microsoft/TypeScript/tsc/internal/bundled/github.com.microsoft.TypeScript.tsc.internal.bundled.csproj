<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework Condition="'$(TargetFramework)'==''">net10.0</TargetFramework>
    <RootNamespace>go.github.com.microsoft.TypeScript.tsc.@internal</RootNamespace>
    <AssemblyName>github.com.microsoft.TypeScript.tsc.internal.bundled</AssemblyName>
    <Product>go2cs</Product>
    <Description>$(AssemblyName) ($(TargetFramework) - $(Configuration))</Description>
    <AssemblyTitle>$(Description)</AssemblyTitle>
    <Authors>$(Product) Authors</Authors>
    <Company>The $(Authors)</Company>
    <Copyright>Copyright © 2018-2026 $(Company)</Copyright>
    <RepositoryUrl>https://github.com/ritchiecarroll/go2cs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>go2cs.ico</ApplicationIcon>
    <!-- `annotations`, not `enable`: Go has no non-nullable pointer, interface, map, slice, channel
         or func, so nullable flow analysis asks a question the source language cannot pose, and
         would warn across the whole conversion. This keeps `?` meaningful (golib's `ж<T>?`) with
         the analysis itself off. -->
    <Nullable>annotations</Nullable>
    <!-- Diagnostics that are structural to the Go emission model, not defects: Go type names
         (CS8981/CS8860), split partial structs (CS0282), Go comparison operators on value types
         (CS0660/CS0661), Go zero values (CS8618), generated unreachable code and labels
         (CS0162/CS0164), generated self-assignment (CS1717), the NaN idiom (CS1718), function
         values in a `map[string]any` (CS8974), and `init()` as a module initializer (CA2255). -->
    <NoWarn>CS0162;CS0164;CS0282;CS0660;CS0661;CS1717;CS1718;CS8618;CS8860;CS8974;CS8981;IDE0060;IDE1006;CA2255</NoWarn>
    <LangVersion Condition="'$(LangVersion)'==''">14</LangVersion>
    <!-- Go strings in `any` slots: go2cs-gen's LiteralInterceptorGenerator boxes a bare C# literal the converter passes
         there, through an interceptor in namespace go2cs.Interceptors; without this opt-in every such call is CS9137.
         A go2cs-gen that cannot load is an error, not the compiler's warning (CS8032, CS8034, CS8784, CS8785, and
         CS9057: it references a newer compiler than the one running it): otherwise the build would go on without the
         interceptors, and the program would see System.String where Go has a string. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);go2cs.Interceptors</InterceptorsNamespaces>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS8034;CS8784;CS8785;CS9057</WarningsAsErrors>
    <!-- What this package's conversion is a function of; nugetgo-pack.ps1 checks its validation proof names the same -->
    <GoInputDigest>sha256-435844dba8192187bb9b66debff59560edf7c496e3ef30e2030b417edaabd643</GoInputDigest>
  </PropertyGroup>

