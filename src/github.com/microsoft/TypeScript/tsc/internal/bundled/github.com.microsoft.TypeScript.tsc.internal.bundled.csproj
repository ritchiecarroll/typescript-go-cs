  <!-- Build outputs are copied to $(OutDir), so this default must also defer to an explicit
       $(BaseOutputPath); otherwise that redirection silently never takes effect. -->
  <PropertyGroup Condition="'$(OutDir)'=='' AND '$(BaseOutputPath)'==''">
    <OutDir>bin/$(Configuration)/$(TargetFramework)/</OutDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(USERPROFILE)'==''">
    <USERPROFILE>$(HOME)</USERPROFILE>
  </PropertyGroup>

  <PropertyGroup Condition="'$(go2csPath)'==''">
    <go2csPath Condition="'$(Configuration)'!='Debug'">$(USERPROFILE)/go2cs/</go2csPath>
    <go2csPath Condition="'$(Configuration)'=='Debug'">$(SolutionDir)</go2csPath>
  </PropertyGroup>

  <!-- Enable native compiled output optimizations. Publishing is an APPLICATION operation, so these
       are scoped off Library: the SDK turns PublishTrimmed into EnableTrimAnalyzer at BUILD time, so
       on a library it buys nothing but IL#### trim warnings the app publish recomputes over the whole
       closure anyway. AllowUnsafeBlocks is a compile setting and stays unconditional. -->
  <PropertyGroup Condition="'$(OutputType)'!='Library'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>True</PublishTrimmed>
    <!-- Trim the framework only: a full trim removes members golib and the converted code reach by reflection. -->
    <TrimMode Condition="'$(TrimMode)'==''">partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Per-assembly ReadyToRun for a single file: the SDK's composite default, compressed, costs seconds of start-up. https://github.com/ritchiecarroll/go2cs/blob/master/docs/Tuning.md -->
    <PublishReadyToRunComposite Condition="'$(PublishReadyToRunComposite)'==''">false</PublishReadyToRunComposite>
    <!-- Opt-in for Ubuntu's packaged .NET 10, where on-stack replacement can end a program early (0x80131506 or a silent
         exit 0); costs about 90 ms of startup; becomes the default if a converted program reproduces it. https://github.com/ritchiecarroll/go2cs/blob/master/docs/KnownIssues.md -->
    <!-- <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops> -->
    <!-- Count calls from the start: .NET otherwise waits until about 100 ms pass with no new method compiled, so a short
         busy phase runs the standard library's small functions unoptimized. Another value is a delay in milliseconds;
         `runtime` keeps .NET's own default. https://github.com/ritchiecarroll/go2cs/blob/master/docs/Tuning.md -->
    <GoCallCountingDelayMs Condition="'$(GoCallCountingDelayMs)'==''">0</GoCallCountingDelayMs>
  </PropertyGroup>

  <ItemGroup Condition="'$(OutputType)'!='Library' AND '$(GoCallCountingDelayMs)'!='runtime'">
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="$(GoCallCountingDelayMs)" />
  </ItemGroup>

  <!-- ReadyToRun compiles each assembly on its own: code in one cannot inline a call into another, and a loop entered
       once never leaves its ReadyToRun code. So golib and the standard library keep ReadyToRun, where start time is
       won, and the program's own code (this project and every project it references from outside $(go2csPath)core)
       is compiled as it runs, so a hot loop is optimized across its calls into the standard library.
       GoReadyToRunUserCode=true compiles it ahead of time too. https://github.com/ritchiecarroll/go2cs/blob/master/docs/Tuning.md -->
  <Target Name="GoKeepOwnCodeOutOfReadyToRun" BeforeTargets="_PrepareForReadyToRunCompilation" DependsOnTargets="_ComputeAssembliesToPostprocessOnPublish"
          Condition="'$(OutputType)'!='Library' AND '$(GoReadyToRunUserCode)'!='true'">
    <PropertyGroup>
      <_GoCoreRoot>$([System.IO.Path]::GetFullPath('$(go2csPath)core/').ToLowerInvariant())</_GoCoreRoot>
    </PropertyGroup>
    <ItemGroup>
      <PublishReadyToRunExclude Include="$(AssemblyName).dll" />
      <PublishReadyToRunExclude Include="%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)"
                                Condition="'%(ResolvedFileToPublish.ReferenceSourceTarget)'=='ProjectReference' AND '%(ResolvedFileToPublish.Extension)'=='.dll' AND !$([System.String]::Copy('%(ResolvedFileToPublish.MSBuildSourceProjectFile)').ToLowerInvariant().StartsWith('$(_GoCoreRoot)'))" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet packaging metadata for library projects; packing itself is explicit ('dotnet pack' via push-nuget.ps1), so plain builds emit no .nupkg -->
  <PropertyGroup Condition="'$(OutputType)'=='Library'">
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- No PackageId: nugetgo-pack.ps1 mints a converted module's one NuGet ID, nugetgo.<dotted module path> -->
    <PackageLicenseFile Condition="Exists('$(MSBuildProjectDirectory)/LICENSE')">LICENSE</PackageLicenseFile>
    <PackageDescription>$(Description) -- C# project converted from Go source</PackageDescription>
    <PackageProjectUrl>https://github.com/ritchiecarroll/go2cs</PackageProjectUrl>
    <PackageIcon>go2cs.png</PackageIcon>
    <PackageTags>$(AssemblyName);go2cs;Golang;go</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(OutputType)'=='Library'">
    <None Include="go2cs.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="go2cs.ico" Pack="true" PackagePath="" Visible="false" />
    <None Include="LICENSE" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/LICENSE')" />
    <None Include="NOTICE" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/NOTICE')" />
    <None Include="AUTHORS" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/AUTHORS')" />
  </ItemGroup>

  <!-- Include the per-package README (emitted by the converter) in the NuGet package -->
  <PropertyGroup Condition="'$(OutputType)'=='Library' AND Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(OutputType)'=='Library' AND Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Expose output of source generators as local files -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
    <PackageReference Include="go.gen" Version="$(GoStdLibVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!-- Define Go type aliases -->
  <ItemGroup>
    <Using Include="go.builtin" Static="True" />
    <Using Include="System" />
    <Using Include="System.Numerics" />
    <Using Include="System.Object" Alias="any" />
    <Using Include="System.Byte" Alias="uint8" />
    <Using Include="System.UInt16" Alias="uint16" />
    <Using Include="System.UInt32" Alias="uint32" />
    <Using Include="System.UInt64" Alias="uint64" />
    <Using Include="System.SByte" Alias="int8" />
    <Using Include="System.Int16" Alias="int16" />
    <Using Include="System.Int32" Alias="int32" />
    <Using Include="System.Int64" Alias="int64" />
    <Using Include="System.Single" Alias="float32" />
    <Using Include="System.Double" Alias="float64" />
    <Using Include="System.Numerics.Complex" Alias="complex128" />
    <Using Include="System.Int32" Alias="rune" />
    <Using Include="System.Numerics.BigInteger" Alias="GoBigConst" />
    <Using Include="System.ComponentModel.DescriptionAttribute" Alias="GoTagAttribute" />
    <Using Include="System.Runtime.CompilerServices.ModuleInitializerAttribute" Alias="GoInitAttribute" />
  </ItemGroup>

  <ItemGroup>
    <!-- Remove all .cs files, including those in sub-folders -->
    <Compile Remove="**/*.cs" />
    <!-- package_info.cs is compiled FIRST, ahead of the globs below. Roslyn orders module
         initializers by compilation ITEM order, and the forced-init import hooks are module
         initializers, so this is what makes "every import hook precedes every one of the package's
         own inits" a deterministic guarantee rather than the alphabetical accident a bare glob
         leaves it as (docs/phase4/DESIGN-import-hook-relocation.md S3).

         Exists()-guarded because ONE shape has to serve every layout: a flat package holds the file
         at its root, an L3 package holds it in the per-GOOS folder (the companion item is added
         beside this one), and a platform-exclusive package built for another target has neither and
         correctly contributes nothing. An unguarded item naming an absent file is not a no-op; it
         is CS2001. -->
    <Compile Include="package_info.cs" Condition="Exists('package_info.cs')" />
    <!-- Include only .cs files from current folder -->
    <Compile Include="*.cs" Exclude="package_info.cs" />
    <!-- Converted test artifacts share this folder but belong to the colocated
         <name>.tests.csproj, which compiles them. A Go test file is `*_test.go`, so its
         conversion is `*_test.cs`. -->
    <Compile Remove="*_test.cs;package_test_info.cs;go2cs_test_host.cs" />
    <!--Remove all sub-folders -->
    <None Remove="*/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="go.lib" Version="$(GoStdLibVersion)" />

    <PackageReference Include="go.embed" Version="$(GoStdLibVersion)" />
    <PackageReference Include="go.io.fs" Version="$(GoStdLibVersion)" />
    <PackageReference Include="go.path.filepath" Version="$(GoStdLibVersion)" />
    <PackageReference Include="go.runtime" Version="$(GoStdLibVersion)" />
    <PackageReference Include="go.strings" Version="$(GoStdLibVersion)" />
    <PackageReference Include="go.sync" Version="$(GoStdLibVersion)" />
    <PackageReference Include="go.testing" Version="$(GoStdLibVersion)" />
    <PackageReference Include="go.time" Version="$(GoStdLibVersion)" />
    <ProjectReference Include="../tspath/github.com.microsoft.TypeScript.tsc.internal.tspath.csproj" />
    <ProjectReference Include="../vfs/github.com.microsoft.TypeScript.tsc.internal.vfs.csproj" />
  </ItemGroup>

</Project>
